# Copy to .env and fill in the two keys.

# Free key from https://publicapi.ohgo.com/accounts/registration
OHGO_API_KEY=

# Free key (prefixed nvapi-) from https://build.nvidia.com
NVIDIA_API_KEY=

# Area to monitor: a region name, or a radius as "lat,lon,miles"
OHGO_REGION=akron
# OHGO_RADIUS=41.1537,-81.3579,20

# Comma-separated routes or place names to alert on
WATCH_ROUTES=I-76,I-80,SR-8,Kent,Akron

POLL_INTERVAL_SECONDS=300
# Spacing between vision calls to stay under NIM's shared ~40 req/min limit
CLASSIFY_DELAY_SECONDS=1.6

# Model overrides (optional)
# NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# NIM_AGENT_MODEL=meta/llama-3.1-70b-instruct

# DB_PATH=data/roadwatch.db
# CHROMA_PATH=data/chroma
